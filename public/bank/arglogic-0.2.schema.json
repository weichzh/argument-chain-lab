{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argument-chain-lab.example/schemas/arglogic-0.2.schema.json",
  "title": "Argument Chain Lab ArgLogic 0.2 formalization instance",
  "type": "object",
  "required": [
    "languageVersion",
    "argumentId",
    "schemeId",
    "contextId",
    "bindings",
    "premises",
    "conclusion"
  ],
  "properties": {
    "languageVersion": {
      "const": "arglogic-0.2"
    },
    "argumentId": {
      "type": "string",
      "minLength": 1
    },
    "schemeId": {
      "type": "string",
      "minLength": 1
    },
    "contextId": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "targetClaimId": {
          "type": [
            "string",
            "null"
          ]
        },
        "bridgeClaimId": {
          "type": [
            "string",
            "null"
          ]
        },
        "factIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\?[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "premises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/premise"
      }
    },
    "conclusion": {
      "$ref": "#/$defs/conclusion"
    },
    "sourceTargetElementIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "criticalQuestionAnswers": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "satisfied",
          "open",
          "defeated",
          "not_applicable",
          "unknown"
        ]
      }
    },
    "explicitAttacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "targetArgumentId",
          "kind"
        ],
        "properties": {
          "targetArgumentId": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "undermine",
              "rebut",
              "undercut"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formula"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "premise": {
      "type": "object",
      "required": [
        "id",
        "status",
        "formula"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "claimRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "axiom",
            "stipulated",
            "ordinary"
          ]
        },
        "contextId": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "$ref": "#/$defs/formula"
        }
      },
      "additionalProperties": false
    },
    "conclusion": {
      "type": "object",
      "required": [
        "formula",
        "targetElementIds"
      ],
      "properties": {
        "claimRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula": {
          "$ref": "#/$defs/formula"
        },
        "targetElementIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "atom": {
      "type": "object",
      "required": [
        "pred",
        "args"
      ],
      "properties": {
        "pred": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "formula": {
      "oneOf": [
        {
          "$ref": "#/$defs/atom"
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/formula"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "and"
          ],
          "properties": {
            "and": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "or"
          ],
          "properties": {
            "or": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "exists"
          ],
          "properties": {
            "exists": {
              "type": "object",
              "required": [
                "vars",
                "where"
              ],
              "properties": {
                "vars": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^\\?"
                  }
                },
                "where": {
                  "$ref": "#/$defs/formula"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}

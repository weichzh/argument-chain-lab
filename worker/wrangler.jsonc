{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "argument-chain-bank",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "CANDIDATES",
      "bucket_name": "argument-chain-candidates"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  }
}
